{
  "name": "snyk-cpp-plugin",
  "description": "Snyk CLI C/C++ plugin",
  "homepage": "https://github.com/snyk/snyk-cpp-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/snyk-cpp-plugin"
  },
  "author": "snyk.io",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "format:check": "prettier --check \"{lib,test}/**/*.{js,ts,json,yml}\"",
    "format": "prettier --write \"{lib,test}/**/*.{js,ts,json,yml}\"",
    "lint": "npm run format:check && npm run lint:eslint",
    "lint:eslint": "eslint --color --cache \"lib/**/*.{js,ts}\"",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "jest --coverage",
    "test:watch": "tsc-watch --onSuccess 'npm run test:unit'",
    "build": "tsc",
    "build-watch": "tsc -w",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@snyk/dep-graph": "^1.31.0",
    "@types/minimatch": "^3.0.5",
    "@types/uuid": "^8.3.4",
    "adm-zip": "^0.6.1",
    "chalk": "^4.1.2",
    "debug": "^4.4.3",
    "hosted-git-info": "^3.0.8",
    "minimatch": "^3.1.5",
    "p-map": "^4.0.0",
    "tar": "^7.5.23",
    "tslib": "^2.9.1",
    "uuid": "^11.1.1",
    "yaml": "^1.10.3"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/debug": "^4.1.13",
    "@types/hosted-git-info": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "os-name": "^3.1.0",
    "prettier": "^1.19.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.8.3"
  }
}
